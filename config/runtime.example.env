# Shared Slack transport
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME
# Optional reliability fallback. Comma-separated channel/DM IDs are polled
# when Socket Mode misses an event.
SLACK_POLL_CHANNELS=D0123456789
SLACK_POLL_INTERVAL_MS=5000

# claude: emit notifications/claude/channel over MCP stdio
# codex: spawn Codex app-server and reply to Slack directly
BRIDGE_RUNTIME=codex

# Codex runtime
CODEX_BIN=codex
CODEX_CWD=/absolute/path/to/workspace
# Isolate the bridge from Codex Desktop's model cache and session store.
CODEX_HOME=/absolute/path/to/bridge-state/codex-home
CODEX_REASONING_EFFORT=high
CODEX_REQUEST_TIMEOUT_MS=30000
CODEX_TURN_TIMEOUT_MS=900000

# Safe unattended default: denied operations fail instead of hanging.
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=workspace-write

# Full Mac control is intentionally opt-in:
# CODEX_SANDBOX=danger-full-access
