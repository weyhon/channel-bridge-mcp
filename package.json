{
  "name": "channel-bridge-mcp",
  "version": "0.2.2",
  "description": "Independent MCP channel bridge for Claude Code, starting with Slack Socket Mode.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "channel-bridge-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:codex": "BRIDGE_RUNTIME=codex node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@slack/socket-mode": "^2.0.4",
    "@slack/web-api": "^7.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
